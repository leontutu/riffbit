{
    "name": "server",
    "version": "0.0.1",
    "description": "",
    "main": "server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "debug": "LOG_LEVEL=debug tsx watch --inspect src/server.ts",
        "build": "esbuild src/server.ts --bundle --platform=node --outfile=dist/server.cjs --packages=external",
        "start": "node dist/server.cjs",
        "test": "vitest run --reporter=verbose",
        "test:watch": "vitest"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "type": "module",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "5.22.0",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "openai": "^6.9.1",
        "pino": "^10.1.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/node": "^24.10.1",
        "@types/supertest": "^6.0.3",
        "esbuild": "^0.25.12",
        "pino-pretty": "^13.1.2",
        "prisma": "^5.22.0",
        "supertest": "^7.1.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.0.8"
    }
